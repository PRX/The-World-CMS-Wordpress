{
  "name": "soflyy/wp-all-export-pro",
  "description": "Export any post type to a CSV or XML file. Edit the exported data, and then re-import it later using WP All Import.",
  "type": "wordpress-plugin",
  "license": "GPLv2",
  "autoload": {
    "psr-4": {
      "Soflyy\\WpAllExportPro\\": "src/"
    },
    "classmap": [
      "vendor-prefixed/"
    ]
  },
  "keywords": [
    "wordpress",
    "plugin",
    "export",
    "wp all export"
  ],
  "homepage": "https://www.wpallimport.com",
  "authors": [
    {
      "name": "WP All Import",
      "homepage": "https://www.wpallimport.com/"
    }
  ],
  "support": {
    "issues": "https://www.wpallimport.com/support"
  },
  "config": {
    "platform": {
      "php": "7.4"
    }
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/soflyy/wpai-test-harness"
    },
    {
      "type": "vcs",
      "url": "https://github.com/soflyy/wpai-updater-sdk"
    }
  ],
  "require": {
    "phpoffice/phpspreadsheet": "^1.30",
    "soflyy/updater": "^2.5.0"
  },
  "require-dev": {
    "soflyy/wpai-test-harness": "dev-master",
    "phpunit/phpunit": "^9.0"
  },
  "scripts": {
    "strauss": "bash bin/strauss.sh",
    "post-install-cmd": "@strauss",
    "post-update-cmd": "@strauss"
  },
  "extra": {
    "strauss": {
      "target_directory": "vendor-prefixed/",
      "namespace_prefix": "Soflyy\\WpAllExportPro\\Vendor\\",
      "classmap_prefix": "Soflyy_WpAllExportPro_Vendor_",
      "packages": [
        "soflyy/updater",
        "phpoffice/phpspreadsheet"
      ],
      "delete_vendor_packages": false,
      "update_call_sites": false,
      "exclude_from_copy": {
        "packages": [
          "symfony/polyfill-mbstring",
          "ezyang/htmlpurifier"
        ]
      },
      "exclude_from_prefix": {
        "namespaces": [
          "HTMLPurifier"
        ]
      }
    }
  }
}
