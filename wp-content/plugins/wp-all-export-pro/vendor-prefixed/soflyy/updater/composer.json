{
    "name": "soflyy/updater",
    "description": "Shared plugin update client for WP All Import, WP All Export and their add-ons.",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "homepage": "https://www.wpallimport.com",
    "authors": [
        {
            "name": "WP All Import",
            "homepage": "https://www.wpallimport.com/"
        }
    ],
    "support": {
        "issues": "https://github.com/soflyy/wpai-updater-sdk/issues"
    },
    "require": {
        "php": "^7.4 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "config": {
        "platform": {
            "php": "7.4"
        },
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.1.x-dev"
        }
    },
    "autoload": {
        "psr-4": {
            "Soflyy\\Updater\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Soflyy\\Updater\\Tests\\": "tests/",
            "Soflyy\\Updater\\Tests\\Updater\\": "tests/updater/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
