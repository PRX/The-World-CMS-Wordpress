<?xml version="1.0" encoding="utf-8"?>
<bundle name="TaxoPress Pro">
    <domain name="taxopress-pro">
        <project name="TaxoPress Pro" slug="taxopress-pro">
            <source>
                <directory>includes-pro</directory>
                <include>
                    <file>taxopress-pro.php</file>
                </include>
            </source>
            <target>
                <directory>languages</directory>
            </target>
            <template>
                <file>languages/taxopress-pro.pot</file>
            </template>
        </project>
    </domain>

      <domain name="publishpress-wordpress-reviews">
    <project name="PublishPress WordPress Reviews">
      <source>
        <directory>lib/vendor/publishpress/wordpress-reviews</directory>
      </source>
      <target>
        <directory>lib/vendor/publishpress/wordpress-reviews/languages</directory>
      </target>
      <template>
        <file>lib/vendor/publishpress/wordpress-reviews/languages/publishpress-wordpress-reviews.pot</file>
      </template>
    </project>
  </domain>
  <domain name="publishpress-instance-protection">
    <project name="PublishPress Instance Protection">
      <source>
        <directory>lib/vendor/publishpress/instance-protection/core</directory>
      </source>
      <target>
        <directory>lib/vendor/publishpress/instance-protection/languages</directory>
      </target>
      <template>
        <file>lib/vendor/publishpress/instance-protection/languages/publishpress-instance-protection.pot</file>
      </template>
    </project>
  </domain>

    <!-- Base domain for general translation files -->
    <domain name="simple-tags">
        <project name="Simple Tags" slug="simple-tags">
            <source>
                <directory>lib/vendor/taxopress/simple-tags</directory>
            </source>
            <target>
                <directory>lib/vendor/taxopress/simple-tags/languages</directory>
            </target>
            <template>
                <file>lib\vendor\taxopress\simple-tags\languages\simple-tags.pot</file>
            </template>
        </project>
    </domain>

    <exclude>
        <directory>vendor</directory>
        <directory>lib</directory>
    </exclude>

</bundle>